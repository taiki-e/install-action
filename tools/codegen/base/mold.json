{
  "repository": "https://github.com/rui314/mold",
  "license_markdown": "[MIT](https://github.com/rui314/mold/blob/main/LICENSE)",
  "tag_prefix": "v",
  "version_range": ">= 2.42.1",
  "platform": {
    "x86_64_linux_gnu": {
      "asset_name": "${package}-${version}-x86_64-linux.tar.gz",
      "bin": "${package}-${version}-x86_64-linux/bin/mold"
    },
    "x86_64_windows": {
      "asset_name": "${package}-${version}-x86_64-windows.zip",
      "bin": "bin/mold"
    },
    "aarch64_linux_gnu": {
      "asset_name": "${package}-${version}-aarch64-linux.tar.gz",
      "bin": "${package}-${version}-aarch64-linux/bin/mold"
    }
  }
}
